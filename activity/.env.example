# Copy this file to activity/.env for local development.
# Keep real secrets out of git.

# Discord application credentials. Required when ACTIVITY_ALLOW_INSECURE_DEV=0.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Optional extra request hardening. Use the application public key from the
# Discord Developer Portal.
DISCORD_PROXY_PUBLIC_KEY=

# Optional test override. Leave unset for real Discord API calls.
DISCORD_API_BASE_URL=

# Activity server.
ACTIVITY_HOST=127.0.0.1
ACTIVITY_PORT=3000
ACTIVITY_PUBLIC_URL=http://127.0.0.1:3000
ACTIVITY_ALLOW_INSECURE_DEV=1
ACTIVITY_TUNNEL=
ACTIVITY_TUNNEL_ORIGIN_URL=
ACTIVITY_SESSION_SECRET=replace-this-dev-secret
ACTIVITY_ASSET_VERSION=
ACTIVITY_DISCONNECT_GRACE_MS=10000
ACTIVITY_SSE_HEARTBEAT_MS=25000

# C++ engine.
BALOOT_SERVER_BIN=../build/baloot-server
BALOOT_TARGET_SCORE=152
BALOOT_READ_TIMEOUT_MS=900000
